# Assimp (Open Asset Import Library) BUILD file
# Supports 50+ 3D model formats (OBJ, GLTF, FBX, STL, etc.)

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # BSD-3-Clause

exports_files(["LICENSE"])

# Generate config.h for Assimp (normally generated by CMake)
genrule(
    name = "gen_config",
    outs = ["include/assimp/config.h"],
    cmd = """cat > $@ << 'EOF'
#ifndef ASSIMP_CONFIG_H_INC
#define ASSIMP_CONFIG_H_INC

/* Define if you want to use assimp without boost */
#define ASSIMP_BUILD_BOOST_WORKAROUND

/* Define ASSIMP_BUILD_NO_XX_IMPORTER to disable specific importers */
#define ASSIMP_BUILD_NO_C4D_IMPORTER 1
#define ASSIMP_BUILD_NO_EXPORT 1
#define ASSIMP_BUILD_NO_PBRT_EXPORTER 1
#define ASSIMP_BUILD_NO_M3D_EXPORTER 1

/* Define to enable or disable specific features */
#define ASSIMP_BUILD_NO_OWN_ZLIB

/* STL container config */
#define AI_NO_EXCEPT

/* Global scale config */
#define AI_CONFIG_GLOBAL_SCALE_FACTOR_DEFAULT 1.0
#define AI_CONFIG_GLOBAL_SCALE_FACTOR_KEY "GLOBAL_SCALE_FACTOR"
#define AI_CONFIG_APP_SCALE_KEY "APP_SCALE"

/* Matrix epsilon for identity checks */
#define AI_CONFIG_CHECK_IDENTITY_MATRIX_EPSILON_DEFAULT 10e-3f

/* Tolerance for fast epsilon checks */
#define AI_FAST_ATOF_RELAVANT_DECIMALS 15

/* Max number of indices per face */
#define AI_MAX_FACE_INDICES 0x7fff

/* Max number of bone weights per vertex */
#define AI_MAX_BONE_WEIGHTS 0x7fffffff

/* Default limit of bone weights per vertex */
#define AI_LMW_MAX_WEIGHTS 4
#define AI_CONFIG_PP_LBW_MAX_WEIGHTS "PP_LBW_MAX_WEIGHTS"

/* UV transformation flags */
#define AI_UVTRAFO_SCALING 0x1
#define AI_UVTRAFO_ROTATION 0x2
#define AI_UVTRAFO_TRANSLATION 0x4
#define AI_UVTRAFO_ALL (AI_UVTRAFO_SCALING | AI_UVTRAFO_ROTATION | AI_UVTRAFO_TRANSLATION)

/* UV transformation config key */
#define AI_CONFIG_PP_TUV_EVALUATE "PP_TUV_EVALUATE"

/* RemoveVCProcess (Remove Vertex Components) config */
#define AI_CONFIG_PP_RVC_FLAGS "PP_RVC_FLAGS"

/* Component flags for RemoveVCProcess */
#define aiComponent_NORMALS 0x2u
#define aiComponent_TANGENTS_AND_BITANGENTS 0x4u
#define aiComponent_COLORS 0x8u
#define aiComponent_TEXCOORDSn(n) (0x100u << n)
#define aiComponent_TEXCOORDS aiComponent_TEXCOORDSn(0)
#define aiComponent_COLORSn(n) (0x10u << n)
#define aiComponent_BONEWEIGHTS 0x200000u
#define aiComponent_ANIMATIONS 0x400000u
#define aiComponent_TEXTURES 0x800000u
#define aiComponent_LIGHTS 0x1000000u
#define aiComponent_CAMERAS 0x2000000u
#define aiComponent_MESHES 0x4000000u
#define aiComponent_MATERIALS 0x8000000u

/* PreTransformVertices config keys */
#define AI_CONFIG_PP_PTV_KEEP_HIERARCHY "PP_PTV_KEEP_HIERARCHY"
#define AI_CONFIG_PP_PTV_NORMALIZE "PP_PTV_NORMALIZE"
#define AI_CONFIG_PP_PTV_ADD_ROOT_TRANSFORMATION "PP_PTV_ADD_ROOT_TRANSFORMATION"
#define AI_CONFIG_PP_PTV_ROOT_TRANSFORMATION "PP_PTV_ROOT_TRANSFORMATION"

/* SplitLargeMeshes config keys */
#define AI_CONFIG_PP_SLM_TRIANGLE_LIMIT "PP_SLM_TRIANGLE_LIMIT"
#define AI_CONFIG_PP_SLM_VERTEX_LIMIT "PP_SLM_VERTEX_LIMIT"
#define AI_SLM_DEFAULT_MAX_TRIANGLES 1000000
#define AI_SLM_DEFAULT_MAX_VERTICES 1000000

/* SplitByBoneCount config keys */
#define AI_CONFIG_PP_SBBC_MAX_BONES "PP_SBBC_MAX_BONES"
#define AI_SBBC_DEFAULT_MAX_BONES 60

/* SortByPType config keys */
#define AI_CONFIG_PP_SBP_REMOVE "PP_SBP_REMOVE"

/* RemoveRedundantMaterials config keys */
#define AI_CONFIG_PP_RRM_EXCLUDE_LIST "PP_RRM_EXCLUDE_LIST"

/* OptimizeGraph config keys */
#define AI_CONFIG_PP_OG_EXCLUDE_LIST "PP_OG_EXCLUDE_LIST"

/* GenVertexNormals config keys */
#define AI_CONFIG_PP_GSN_MAX_SMOOTHING_ANGLE "PP_GSN_MAX_SMOOTHING_ANGLE"

/* CalcTangentSpace config keys */
#define AI_CONFIG_PP_CT_MAX_SMOOTHING_ANGLE "PP_CT_MAX_SMOOTHING_ANGLE"
#define AI_CONFIG_PP_CT_TEXTURE_CHANNEL_INDEX "PP_CT_TEXTURE_CHANNEL_INDEX"

/* DeboneProcess config keys */
#define AI_CONFIG_PP_DB_THRESHOLD "PP_DB_THRESHOLD"
#define AI_CONFIG_PP_DB_ALL_OR_NONE "PP_DB_ALL_OR_NONE"

/* ImproveCacheLocality config keys */
#define AI_CONFIG_PP_ICL_PTCACHE_SIZE "PP_ICL_PTCACHE_SIZE"
#define PP_ICL_PTCACHE_SIZE 12

/* FindDegenerates config keys */
#define AI_CONFIG_PP_FD_REMOVE "PP_FD_REMOVE"
#define AI_CONFIG_PP_FD_CHECKAREA "PP_FD_CHECKAREA"

/* FindInvalidData config keys */
#define AI_CONFIG_PP_FID_ANIM_ACCURACY "PP_FID_ANIM_ACCURACY"
#define AI_CONFIG_PP_FID_IGNORE_TEXTURECOORDS "PP_FID_IGNORE_TEXTURECOORDS"

/* Export config */
#define AI_CONFIG_EXPORT_POINT_CLOUDS "EXPORT_POINT_CLOUDS"

/* AC3D Importer config */
#define AI_CONFIG_IMPORT_AC_SEPARATE_BFCULL "IMPORT_AC_SEPARATE_BFCULL"
#define AI_CONFIG_IMPORT_AC_EVAL_SUBDIVISION "IMPORT_AC_EVAL_SUBDIVISION"

/* ASE Importer config */
#define AI_CONFIG_IMPORT_ASE_RECONSTRUCT_NORMALS "IMPORT_ASE_RECONSTRUCT_NORMALS"

/* Collada Importer config */
#define AI_CONFIG_IMPORT_COLLADA_IGNORE_UP_DIRECTION "IMPORT_COLLADA_IGNORE_UP_DIRECTION"
#define AI_CONFIG_IMPORT_COLLADA_IGNORE_UNIT_SIZE "IMPORT_COLLADA_IGNORE_UNIT_SIZE"
#define AI_CONFIG_IMPORT_COLLADA_USE_COLLADA_NAMES "IMPORT_COLLADA_USE_COLLADA_NAMES"

/* FBX Importer config */
#define AI_CONFIG_IMPORT_FBX_READ_ALL_GEOMETRY_LAYERS "IMPORT_FBX_READ_ALL_GEOMETRY_LAYERS"
#define AI_CONFIG_IMPORT_FBX_READ_ALL_MATERIALS "IMPORT_FBX_READ_ALL_MATERIALS"
#define AI_CONFIG_IMPORT_FBX_READ_MATERIALS "IMPORT_FBX_READ_MATERIALS"
#define AI_CONFIG_IMPORT_FBX_READ_TEXTURES "IMPORT_FBX_READ_TEXTURES"
#define AI_CONFIG_IMPORT_FBX_READ_CAMERAS "IMPORT_FBX_READ_CAMERAS"
#define AI_CONFIG_IMPORT_FBX_READ_LIGHTS "IMPORT_FBX_READ_LIGHTS"
#define AI_CONFIG_IMPORT_FBX_READ_ANIMATIONS "IMPORT_FBX_READ_ANIMATIONS"
#define AI_CONFIG_IMPORT_FBX_READ_WEIGHTS "IMPORT_FBX_READ_WEIGHTS"
#define AI_CONFIG_IMPORT_FBX_STRICT_MODE "IMPORT_FBX_STRICT_MODE"
#define AI_CONFIG_IMPORT_FBX_PRESERVE_PIVOTS "IMPORT_FBX_PRESERVE_PIVOTS"
#define AI_CONFIG_IMPORT_FBX_OPTIMIZE_EMPTY_ANIMATION_CURVES "IMPORT_FBX_OPTIMIZE_EMPTY_ANIMATION_CURVES"
#define AI_CONFIG_IMPORT_FBX_EMBEDDED_TEXTURES_LEGACY_NAMING "IMPORT_FBX_EMBEDDED_TEXTURES_LEGACY_NAMING"
#define AI_CONFIG_FBX_CONVERT_TO_M "FBX_CONVERT_TO_M"
#define AI_CONFIG_FBX_USE_SKELETON_BONE_CONTAINER "FBX_USE_SKELETON_BONE_CONTAINER"

/* Irr (Irrlicht) Importer config */
#define AI_CONFIG_IMPORT_IRR_ANIM_FPS "IMPORT_IRR_ANIM_FPS"

/* LWO (LightWave Object) Importer config */
#define AI_CONFIG_IMPORT_LWO_ONE_LAYER_ONLY "IMPORT_LWO_ONE_LAYER_ONLY"

/* LWS (LightWave Scene) Importer config */
#define AI_CONFIG_IMPORT_LWS_ANIM_START "IMPORT_LWS_ANIM_START"
#define AI_CONFIG_IMPORT_LWS_ANIM_END "IMPORT_LWS_ANIM_END"

/* MD (Quake) Importer config */
#define AI_CONFIG_IMPORT_MD2_KEYFRAME "IMPORT_MD2_KEYFRAME"
#define AI_CONFIG_IMPORT_MD3_KEYFRAME "IMPORT_MD3_KEYFRAME"
#define AI_CONFIG_IMPORT_MD3_HANDLE_MULTIPART "IMPORT_MD3_HANDLE_MULTIPART"
#define AI_CONFIG_IMPORT_MD3_SKIN_NAME "IMPORT_MD3_SKIN_NAME"
#define AI_CONFIG_IMPORT_MD3_LOAD_SHADERS "IMPORT_MD3_LOAD_SHADERS"
#define AI_CONFIG_IMPORT_MD3_SHADER_SRC "IMPORT_MD3_SHADER_SRC"
#define AI_CONFIG_IMPORT_MD5_NO_ANIM_AUTOLOAD "IMPORT_MD5_NO_ANIM_AUTOLOAD"
#define AI_CONFIG_IMPORT_MDC_KEYFRAME "IMPORT_MDC_KEYFRAME"
#define AI_CONFIG_IMPORT_MDL_KEYFRAME "IMPORT_MDL_KEYFRAME"

/* MDL (Half-Life 1) Importer config */
#define AI_CONFIG_IMPORT_MDL_COLORMAP "IMPORT_MDL_COLORMAP"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_ANIMATIONS "IMPORT_MDL_HL1_READ_ANIMATIONS"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_ANIMATION_EVENTS "IMPORT_MDL_HL1_READ_ANIMATION_EVENTS"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_BLEND_CONTROLLERS "IMPORT_MDL_HL1_READ_BLEND_CONTROLLERS"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_SEQUENCE_TRANSITIONS "IMPORT_MDL_HL1_READ_SEQUENCE_TRANSITIONS"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_ATTACHMENTS "IMPORT_MDL_HL1_READ_ATTACHMENTS"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_BONE_CONTROLLERS "IMPORT_MDL_HL1_READ_BONE_CONTROLLERS"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_HITBOXES "IMPORT_MDL_HL1_READ_HITBOXES"
#define AI_CONFIG_IMPORT_MDL_HL1_READ_MISC_GLOBAL_INFO "IMPORT_MDL_HL1_READ_MISC_GLOBAL_INFO"
#define AI_CONFIG_IMPORT_MDL_HL1_TRANSFORM_COORD_SYSTEM "IMPORT_MDL_HL1_TRANSFORM_COORD_SYSTEM"

/* General Keyframe config */
#define AI_CONFIG_IMPORT_GLOBAL_KEYFRAME "IMPORT_GLOBAL_KEYFRAME"

/* Ogre (3D engine) Importer config */
#define AI_CONFIG_IMPORT_OGRE_MATERIAL_FILE "IMPORT_OGRE_MATERIAL_FILE"
#define AI_CONFIG_IMPORT_OGRE_TEXTURETYPE_FROM_FILENAME "IMPORT_OGRE_TEXTURETYPE_FROM_FILENAME"

/* SMD (Valve Source Engine) Importer config */
#define AI_CONFIG_IMPORT_SMD_KEYFRAME "IMPORT_SMD_KEYFRAME"
#define AI_CONFIG_IMPORT_SMD_LOAD_ANIMATION_LIST "IMPORT_SMD_LOAD_ANIMATION_LIST"

/* Terragen Importer config */
#define AI_CONFIG_IMPORT_TER_MAKE_UVS "IMPORT_TER_MAKE_UVS"

/* Unreal Engine Importer config */
#define AI_CONFIG_IMPORT_UNREAL_KEYFRAME "IMPORT_UNREAL_KEYFRAME"
#define AI_CONFIG_IMPORT_UNREAL_HANDLE_FLAGS "IMPORT_UNREAL_HANDLE_FLAGS"

/* General import config */
#define AI_CONFIG_IMPORT_NO_SKELETON_MESHES "IMPORT_NO_SKELETON_MESHES"
#define AI_CONFIG_IMPORT_REMOVE_EMPTY_BONES "IMPORT_REMOVE_EMPTY_BONES"
#define AI_CONFIG_FAVOUR_SPEED "FAVOUR_SPEED"
#define AI_CONFIG_GLOB_MEASURE_TIME "GLOB_MEASURE_TIME"

/* Max string length */
#define MAXLEN 1024

/* Architecture detection */
#if defined(__x86_64__) || defined(_M_X64) || defined(__aarch64__)
  #define ASSIMP_BUILD_ARCHITECTURE "64"
#else
  #define ASSIMP_BUILD_ARCHITECTURE "32"
#endif

/* Compiler detection */
#if defined(__clang__)
  #define ASSIMP_BUILD_COMPILER "clang"
#elif defined(__GNUC__)
  #define ASSIMP_BUILD_COMPILER "gcc"
#else
  #define ASSIMP_BUILD_COMPILER "unknown"
#endif

#endif // ASSIMP_CONFIG_H_INC
EOF
""",
)

# Generate stub AssimpPCH.h (precompiled header stub)
genrule(
    name = "gen_pch",
    outs = ["code/AssimpPCH.h"],
    cmd = """cat > $@ << 'EOF'
#ifndef ASSIMP_PCH_H_INC
#define ASSIMP_PCH_H_INC

// Stub precompiled header for Bazel build
// Assimp normally uses CMake-generated PCH, but we build without it

// Common STL includes used throughout Assimp
#include <vector>
#include <map>
#include <string>
#include <memory>
#include <algorithm>
#include <cstdint>
#include <cstring>
#include <cassert>

#endif // ASSIMP_PCH_H_INC
EOF
""",
)

# Generate stub revision.h (normally generated by CMake from git info)
genrule(
    name = "gen_revision",
    outs = ["include/assimp/revision.h"],
    cmd = """cat > $@ << 'EOF'
#ifndef ASSIMP_REVISION_H_INC
#define ASSIMP_REVISION_H_INC

#define GitVersion 0x0
#define GitBranch "bazel-build"
#define VER_MAJOR 5
#define VER_MINOR 4
#define VER_PATCH 3
#define VER_BUILD 0

#endif // ASSIMP_REVISION_H_INC
EOF
""",
)

cc_library(
    name = "assimp",
    srcs = glob([
        "code/**/*.cpp",
        "code/**/*.c",
        "contrib/unzip/*.c",  # Add minizip sources
    ], exclude = [
        "code/**/*_test.cpp",
        "code/**/*Test.cpp",
        "code/**/main.cpp",
        "code/AssetLib/Blender/**/*",  # Exclude Blender - needs DNA parser
        "code/AssetLib/MMD/**/*",  # Exclude MMD (MikuMikuDance) - needs UTF8-CPP
        "code/AssetLib/OpenGEX/**/*",  # Exclude OpenGEX - needs OpenDDL parser
        "code/AssetLib/SIB/**/*",  # Exclude SIB (Silo Binary) - needs UTF8-CPP
        "code/AssetLib/STEPParser/**/*",  # Exclude STEP parser - needs UTF8-CPP
        "code/AssetLib/glTF/**/*",  # Exclude glTF 1.0 - needs RapidJSON
        "code/AssetLib/glTF2/**/*",  # Exclude glTF2 - needs RapidJSON (TODO: add rapidjson)
        "contrib/unzip/miniunz.c",  # Exclude minizip main
    ]) + [":gen_config", ":gen_pch", ":gen_revision"],
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
        "include/**/*.inl",
        "code/**/*.h",
        "code/**/*.hpp",
        "code/**/*.inl",  # Include .inl files from code directory
        "contrib/utf8cpp/source/**/*.h",  # UTF8-CPP headers
        "contrib/unzip/**/*.h",  # minizip headers
        "contrib/zip/**/*.h",  # minizip headers
    ]),
    copts = [
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-DASSIMP_BUILD_NO_C4D_IMPORTER",
        "-DASSIMP_BUILD_NO_EXPORT",
        "-DASSIMP_BUILD_NO_PBRT_EXPORTER",
        "-DASSIMP_BUILD_NO_M3D_EXPORTER",
        "-DASSIMP_BUILD_NO_M3D_IMPORTER",
        # Disable complex importers that need extra dependencies
        "-DASSIMP_BUILD_NO_BLEND_IMPORTER",
        "-DASSIMP_BUILD_NO_SIB_IMPORTER",
        "-DASSIMP_BUILD_NO_IFC_IMPORTER",
        "-DASSIMP_BUILD_NO_STEP_IMPORTER",
        "-DASSIMP_BUILD_NO_USD_IMPORTER",  # Needs tinyusdz
        "-DASSIMP_BUILD_NO_M3D_IMPORTER",  # Needs STB includes properly configured
        "-DASSIMP_BUILD_NO_MMD_IMPORTER",  # Needs UTF8-CPP, specialized anime format
        "-DASSIMP_BUILD_NO_OPENGEX_IMPORTER",  # Needs OpenDDL parser library
        "-DASSIMP_BUILD_NO_GLTF_IMPORTER",  # Needs RapidJSON
        "-DASSIMP_BUILD_NO_GLTF2_IMPORTER",  # Needs RapidJSON
        # Keep OBJ, FBX, STL which are most common
    ],
    includes = [
        "include",
        "code",
        "contrib/utf8cpp/source",
        "contrib/poly2tri",
        "contrib",
        "contrib/stb",
        "contrib/unzip",
        "contrib/zip",
    ],
    linkopts = ["-lz"],
    deps = ["@pugixml//:pugixml"],
)
