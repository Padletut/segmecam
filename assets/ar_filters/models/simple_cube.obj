# Simple Cube Model
# Basic 8-vertex cube for testing
# Size: 0.05 units (centered at origin)

mtllib simple_cube.mtl

# Vertices
v -0.025 -0.025 0.025
v 0.025 -0.025 0.025
v 0.025 0.025 0.025
v -0.025 0.025 0.025
v -0.025 -0.025 -0.025
v 0.025 -0.025 -0.025
v 0.025 0.025 -0.025
v -0.025 0.025 -0.025

# Normals
vn 0 0 1
vn 1 0 0
vn 0 0 -1
vn -1 0 0
vn 0 1 0
vn 0 -1 0

# Texture coordinates
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Faces
usemtl cube_material
# Front face
f 1/1/1 2/2/1 3/3/1 4/4/1
# Right face
f 2/1/2 6/2/2 7/3/2 3/4/2
# Back face
f 6/1/3 5/2/3 8/3/3 7/4/3
# Left face
f 5/1/4 1/2/4 4/3/4 8/4/4
# Top face
f 4/1/5 3/2/5 7/3/5 8/4/5
# Bottom face
f 5/1/6 6/2/6 2/3/6 1/4/6
