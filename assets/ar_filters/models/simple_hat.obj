# Simple Top Hat Model
# Cylinder for hat body + disk for brim
# For testing AR filter 3D model loading

mtllib simple_hat.mtl

# Hat body vertices (cylinder)
# Center at (0, 0.05, 0), radius 0.03, height 0.08
# Bottom ring
v 0.03 0.01 0
v 0.0212 0.01 0.0212
v 0 0.01 0.03
v -0.0212 0.01 0.0212
v -0.03 0.01 0
v -0.0212 0.01 -0.0212
v 0 0.01 -0.03
v 0.0212 0.01 -0.0212
# Top ring
v 0.03 0.09 0
v 0.0212 0.09 0.0212
v 0 0.09 0.03
v -0.0212 0.09 0.0212
v -0.03 0.09 0
v -0.0212 0.09 -0.0212
v 0 0.09 -0.03
v 0.0212 0.09 -0.0212
# Center points for caps
v 0 0.01 0
v 0 0.09 0

# Brim vertices (flat disk)
# Inner ring (same radius as hat body)
v 0.03 0.01 0
v 0.0212 0.01 0.0212
v 0 0.01 0.03
v -0.0212 0.01 0.0212
v -0.03 0.01 0
v -0.0212 0.01 -0.0212
v 0 0.01 -0.03
v 0.0212 0.01 -0.0212
# Outer ring (larger radius for brim)
v 0.05 0.01 0
v 0.0354 0.01 0.0354
v 0 0.01 0.05
v -0.0354 0.01 0.0354
v -0.05 0.01 0
v -0.0354 0.01 -0.0354
v 0 0.01 -0.05
v 0.0354 0.01 -0.0354

# Vertex normals
vn 1 0 0
vn 0.707 0 0.707
vn 0 0 1
vn -0.707 0 0.707
vn -1 0 0
vn -0.707 0 -0.707
vn 0 0 -1
vn 0.707 0 -0.707
vn 0 1 0
vn 0 -1 0

# Texture coordinates
vt 0 0
vt 0.125 0
vt 0.25 0
vt 0.375 0
vt 0.5 0
vt 0.625 0
vt 0.75 0
vt 0.875 0
vt 1 0
vt 0 0.5
vt 0.125 0.5
vt 0.25 0.5
vt 0.375 0.5
vt 0.5 0.5
vt 0.625 0.5
vt 0.75 0.5
vt 0.875 0.5
vt 1 0.5
vt 0 1
vt 0.125 1
vt 0.25 1
vt 0.375 1
vt 0.5 1
vt 0.625 1
vt 0.75 1
vt 0.875 1
vt 1 1

# Hat body faces
usemtl hat_body_material
# Side faces (quads become triangles)
f 1/1/1 9/10/1 10/11/2 2/2/2
f 2/2/2 10/11/2 11/12/3 3/3/3
f 3/3/3 11/12/3 12/13/4 4/4/4
f 4/4/4 12/13/4 13/14/5 5/5/5
f 5/5/5 13/14/5 14/15/6 6/6/6
f 6/6/6 14/15/6 15/16/7 7/7/7
f 7/7/7 15/16/7 16/17/8 8/8/8
f 8/8/8 16/17/8 9/10/1 1/1/1

# Top cap (triangles from center)
f 18/19/9 9/10/9 10/11/9
f 18/19/9 10/11/9 11/12/9
f 18/19/9 11/12/9 12/13/9
f 18/19/9 12/13/9 13/14/9
f 18/19/9 13/14/9 14/15/9
f 18/19/9 14/15/9 15/16/9
f 18/19/9 15/16/9 16/17/9
f 18/19/9 16/17/9 9/10/9

# Brim faces
usemtl brim_material
# Top surface (quads)
f 19/1/9 27/10/9 28/11/9 20/2/9
f 20/2/9 28/11/9 29/12/9 21/3/9
f 21/3/9 29/12/9 30/13/9 22/4/9
f 22/4/9 30/13/9 31/14/9 23/5/9
f 23/5/9 31/14/9 32/15/9 24/6/9
f 24/6/9 32/15/9 33/16/9 25/7/9
f 25/7/9 33/16/9 34/17/9 26/8/9
f 26/8/9 34/17/9 27/10/9 19/1/9

# Bottom surface (quads, reversed winding)
f 27/10/10 19/1/10 20/2/10 28/11/10
f 28/11/10 20/2/10 21/3/10 29/12/10
f 29/12/10 21/3/10 22/4/10 30/13/10
f 30/13/10 22/4/10 23/5/10 31/14/10
f 31/14/10 23/5/10 24/6/10 32/15/10
f 32/15/10 24/6/10 25/7/10 33/16/10
f 33/16/10 25/7/10 26/8/10 34/17/10
f 34/17/10 26/8/10 19/1/10 27/10/10

# Outer edge
f 27/10/1 34/17/8 33/16/7 32/15/6
f 32/15/6 31/14/5 30/13/4 29/12/3
f 29/12/3 28/11/2 27/10/1
